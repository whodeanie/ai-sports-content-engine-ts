# Anthropic API key. Get one at https://console.anthropic.com.
# Pricing: Claude Sonnet 4.6 is roughly 3 USD / 15 USD per million input/output tokens.
# A typical generation uses ~3k input + ~1k output tokens, ~$0.025 per article.
ANTHROPIC_API_KEY=

# Model to use. Default: claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ESPN unofficial endpoint base. No key required.
ESPN_API_BASE=https://site.api.espn.com/apis/site/v2/sports
