# Groq API key. Get one free at https://console.groq.com.
# Free tier covers Llama 3.3 70B with generous daily token limits, plenty for
# personal and educational use. The route falls back gracefully when the key
# is missing or the daily limit is hit.
GROQ_API_KEY=

# Model to use. Default: llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# ESPN unofficial endpoint base. No key required.
ESPN_API_BASE=https://site.api.espn.com/apis/site/v2/sports
